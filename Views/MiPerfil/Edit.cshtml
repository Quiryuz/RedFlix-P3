@model RedFlix.Models.ProfileViewModel

@{
    ViewBag.Title = "Editar perfil";
    ViewBag.ModuleTitle = "Editar perfil";
    ViewBag.ModuleSubtitle = "Actualiza el nombre, icono o contrasena";
    ViewBag.ShowCreate = false;
}

@Html.Partial("_ModuleHeader")

<div class="module-card">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)

        <div class="module-form">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(model => model.Nombre)
                @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Icono</label>
                <div class="profile-icon-options">
                    @foreach (var icono in Model.IconosDisponibles)
                    {
                        <label class="profile-icon-option">
                            <input type="radio" name="Icono" value="@icono" @(Model.Icono == icono ? "checked" : "") />
                            <span class="profile-avatar profile-avatar-sm profile-avatar-@icono"></span>
                        </label>
                    }
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.ContrasenaPerfil)
                @Html.PasswordFor(model => model.ContrasenaPerfil, new { @class = "form-control", placeholder = "Opcional" })
                <small class="text-muted">Si dejas el campo vacio, el perfil quedara sin contrasena.</small>
            </div>

            <div class="module-form-actions">
                <input type="submit" value="Guardar cambios" class="btn btn-danger" />
                @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-outline-light" })
            </div>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
