@model RedFlix.Models.ProfileViewModel

@{
    ViewBag.Title = "Detalle de perfil";
    ViewBag.ModuleTitle = "Detalle de perfil";
    ViewBag.ModuleSubtitle = "Informacion del perfil seleccionado";
    ViewBag.ShowCreate = false;
}

@Html.Partial("_ModuleHeader")

<div class="module-card">
    <div class="profile-detail">
        <div class="profile-avatar profile-avatar-lg profile-avatar-@Model.Icono"></div>
        <dl class="dl-horizontal module-details">
            <dt>Nombre</dt>
            <dd>@Model.Nombre</dd>

            <dt>Contrasena</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.ContrasenaPerfil) ? "Sin contrasena" : "Configurada")</dd>

            <dt>Cuenta</dt>
            <dd>@Model.UsuarioNombre</dd>
        </dl>
    </div>
</div>

<div class="module-footer-links">
    @Html.ActionLink("Editar", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-light btn-sm" })
    @Html.ActionLink("Volver a mi perfil", "Menu", null, new { @class = "module-back-link" })
</div>
