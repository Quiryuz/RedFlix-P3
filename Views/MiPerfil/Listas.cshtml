@model IEnumerable<RedFlix.listas>

@{
    ViewBag.Title = "Mis listas";
    ViewBag.ModuleTitle = "Mis listas";
    ViewBag.ModuleSubtitle = "Listas del perfil activo: " + (ViewBag.PerfilActivo ?? "");
    ViewBag.ShowCreate = false;
}

@Html.Partial("_ModuleHeader")

<div class="module-footer-links mb-3">
    @Html.ActionLink("Crear lista", "CrearLista", null, new { @class = "btn btn-danger btn-sm" })
    @Html.ActionLink("Mis favoritos", "Favoritos", null, new { @class = "btn btn-outline-light btn-sm" })
    @Html.ActionLink("Volver a mi perfil", "Menu", null, new { @class = "module-back-link" })
</div>

<div class="module-card module-card-table">
    <div class="table-responsive">
        <table class="table module-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.nombre</td>
                        <td class="module-actions">
                            @Html.ActionLink("Ver contenido", "DetalleLista", new { id = item.ID }, new { @class = "module-action" })
                            @Html.ActionLink("Editar", "EditarLista", new { id = item.ID }, new { @class = "module-action" })
                            @Html.ActionLink("Eliminar", "EliminarLista", new { id = item.ID }, new { @class = "module-action module-action-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
