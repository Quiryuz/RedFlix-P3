@model RedFlix.Models.UserListViewModel

@{
    ViewBag.Title = Model.Nombre;
    ViewBag.ModuleTitle = Model.Nombre;
    ViewBag.ModuleSubtitle = "Contenido guardado en esta lista";
    ViewBag.ShowCreate = false;
}

@Html.Partial("_ModuleHeader")

<div class="module-footer-links mb-3">
    @Html.ActionLink("Volver a mis listas", "Listas", null, new { @class = "btn btn-outline-light btn-sm" })
</div>

@if (Model.Contenidos == null || !Model.Contenidos.Any())
{
    <div class="module-card">
        <p class="text-muted mb-0">Esta lista todavia no tiene peliculas o series.</p>
    </div>
}
else
{
    <div class="catalog-grid">
        @foreach (var item in Model.Contenidos)
        {
            var controller = item.Tipo == "Serie" ? "Series" : "Peliculas";
            <div class="catalog-card">
                <a href="@Url.Action("Detalle", controller, new { id = item.TmdbId })" class="catalog-card-link">
                    <img src="@RedFlix.Services.TMDBService.GetPosterUrl(item.PosterPath)" alt="@item.Titulo" class="catalog-poster" />
                    <div class="catalog-card-body">
                        <h3>@item.Titulo</h3>
                        <p class="catalog-meta">@item.Tipo - Puntaje @item.Puntaje.ToString("0.0")</p>
                    </div>
                </a>
                <div class="content-actions">
                    @using (Html.BeginForm("QuitarDeLista", "MiPerfil", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="listaId" value="@Model.ID" />
                        <input type="hidden" name="tmdbId" value="@item.TmdbId" />
                        <input type="hidden" name="tipo" value="@item.Tipo" />
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">Quitar</button>
                    }
                </div>
            </div>
        }
    </div>
}
