@model IEnumerable<RedFlix.Models.ProfileViewModel>

@{
    ViewBag.Title = "Elegir perfil";
}

<section class="profile-selection-page">
    <h1>¿Quién está mirando?</h1>

    @if (Model == null || !Model.Any())
    {
        <p class="text-muted">Aún no tenés perfiles creados.</p>
        @Html.ActionLink("Crear perfil", "Create", null, new { @class = "btn btn-danger btn-sm mt-3" })
    }
    else
    {
        <div class="profile-selection-grid">
            @foreach (var item in Model)
            {
                <a href="@Url.Action("Seleccionar", new { id = item.ID })" class="profile-selection-item">
                    <div class="profile-avatar profile-avatar-lg profile-avatar-@item.Icono"></div>
                    <span>@item.Nombre</span>
                </a>
            }
        </div>
    }
</section>
