@model RedFlix.usuarios

@{
    ViewBag.Title = "Edit";
}

@{ ViewBag.ModuleTitle = "Editar"; ViewBag.ModuleSubtitle = "Gestion de cuentas y accesos"; ViewBag.ShowCreate = false; }

@Html.Partial("_ModuleHeader")

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Cambios registrados con éxito"]
    </div>
}
<div class="module-card">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

    <div class="form-horizontal module-form">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.ID)

        <div class="form-group">
            @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Mail, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Mail, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Mail, "", new { @class = "text-danger" })
            </div>
        </div>

        @if (ViewBag.EsAdministrador)
        {
            <div class="form-group">
                @Html.LabelFor(model => model.RolID, "Rol",
                    htmlAttributes: new { @class = "control-label col-md-2" })

                <div class="col-md-10">
                    @Html.DropDownList("RolID", null,
                        htmlAttributes: new { @class = "form-control" })

                    @Html.ValidationMessageFor(model => model.RolID, "",
                        new { @class = "text-danger" })
                </div>
            </div>
        }
        @*agregado un condicional para desplegar opcion de cambio de rol, solo lo pueden ver los admins*@
        @*cambio: eliminado apartado de contraseña tras el hash, para que quede mas hermético*@
        @*cree un apartado distinto para cambiarla, fuera del edit*@

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Guardar Cambios" class="btn btn-danger" />
            </div>
        </div>
    </div>
    }

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            @Html.ActionLink(
                "Cambiar contraseña",
                "CambiarContrasena",
                new { id = Model.ID },
                new { @class = "btn btn-warning" })
        </div>
    </div>

    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }
</div>
<div class="module-footer-links">
    @Html.ActionLink("Volver al listado", "Index", null, new { @class = "module-back-link" })
</div>
