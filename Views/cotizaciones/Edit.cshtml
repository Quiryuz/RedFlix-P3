@model RedFlix.cotizaciones

@{
    ViewBag.Title = "Edit";
}

@{ ViewBag.ModuleTitle = "Editar"; ViewBag.ModuleSubtitle = "Historial de tipos de cambio"; ViewBag.ShowCreate = false; }

@Html.Partial("_ModuleHeader")

<div class="module-card">
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal module-form">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.ID)

        @Html.HiddenFor(model => model.tipoMoneda)

        @Html.HiddenFor(model => model.valor)

        @Html.HiddenFor(model => model.fecha)

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-danger" />
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
</div>
<div class="module-footer-links">
    @Html.ActionLink("Volver al listado", "Index", null, new { @class = "module-back-link" })
</div>
