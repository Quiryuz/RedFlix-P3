@model RedFlix.cotizaciones

@{
    ViewBag.Title = "Details";
}

@{ ViewBag.ModuleTitle = "Detalle"; ViewBag.ModuleSubtitle = "Historial de tipos de cambio"; ViewBag.ShowCreate = false; }

@Html.Partial("_ModuleHeader")

<div class="module-card">
<div>
    <hr />
    <dl class="dl-horizontal module-details">
    </dl>
</div>
</div>
<div class="module-footer-links">
    @Html.ActionLink("Editar", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-light btn-sm" })
    @Html.ActionLink("Volver al listado", "Index", null, new { @class = "module-back-link" })
</div>
