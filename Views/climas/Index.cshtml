@model IEnumerable<RedFlix.clima>

@{
    ViewBag.Title = "Index";
}

@{ ViewBag.ModuleTitle = "Clima"; ViewBag.ModuleSubtitle = "Registros de informacion climatica"; ViewBag.CreateText = "Nuevo registro"; }

@Html.Partial("_ModuleHeader")

<div class="module-card module-card-table">
    <div class="table-responsive">
<table class="table module-table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.fecha)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.temperatura)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.descripcionClima)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.icono)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.fecha)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.temperatura)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.descripcionClima)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.icono)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.ID }) |
            @Html.ActionLink("Detalle", "Details", new { id=item.ID }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.ID })
        </td>
    </tr>
}

</table>
    </div>
</div>

