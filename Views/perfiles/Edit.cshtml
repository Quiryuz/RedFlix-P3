@model RedFlix.perfiles

@{
    ViewBag.Title = "Edit";
    var iconos = ViewBag.Iconos as string[] ?? RedFlix.Services.ProfileService.IconosPredeterminados;
    var iconoSeleccionado = Model != null && !string.IsNullOrWhiteSpace(Model.Icono) ? Model.Icono : iconos[0];
    var contrasenaPerfil = ViewBag.ContrasenaPerfil as string;
}

@{ ViewBag.ModuleTitle = "Editar"; ViewBag.ModuleSubtitle = "Perfiles por cuenta de usuario"; ViewBag.ShowCreate = false; }

@Html.Partial("_ModuleHeader")

<div class="module-card">
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal module-form">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.ID)

        <div class="form-group">
            @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label>Icono</label>
            <div class="profile-icon-options">
                @foreach (var icono in iconos)
                {
                    <label class="profile-icon-option">
                        <input type="radio" name="Icono" value="@icono" @(iconoSeleccionado == icono ? "checked" : "") />
                        <span class="profile-avatar profile-avatar-sm profile-avatar-@icono"></span>
                    </label>
                }
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.usuarioID, "usuarioID", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("usuarioID", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.usuarioID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label>Contrasena del perfil</label>
            <input type="password" name="ContrasenaPerfil" class="form-control" value="@contrasenaPerfil" placeholder="Opcional" />
            <small class="text-muted">Si la dejas vacia, el perfil quedara sin contrasena.</small>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Guardar cambios" class="btn btn-danger" />
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
</div>
<div class="module-footer-links">
    @Html.ActionLink("Volver al listado", "Index", null, new { @class = "module-back-link" })
</div>
