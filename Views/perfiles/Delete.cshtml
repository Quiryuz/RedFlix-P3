@model RedFlix.perfiles

@{
    ViewBag.Title = "Delete";
    var contrasenaPerfil = ViewBag.ContrasenaPerfil as string;
}

@{ ViewBag.ModuleTitle = "Eliminar"; ViewBag.ModuleSubtitle = "Perfiles por cuenta de usuario"; ViewBag.ShowCreate = false; }

@Html.Partial("_ModuleHeader")

<div class="module-card">
<p class="module-delete-warning">Estas seguro de que queres eliminar este registro?</p>
<div>
    <hr />
    <dl class="dl-horizontal module-details">
        <dt>
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Icono)
        </dt>

        <dd>
            <span class="profile-avatar profile-avatar-sm profile-avatar-@Model.Icono"></span>
        </dd>

        <dt>
            Contraseña
        </dt>

        <dd>
            @(string.IsNullOrWhiteSpace(contrasenaPerfil) ? "Sin contraseña" : "Configurada")
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.usuarios.Nombre)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.usuarios.Nombre)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Eliminar" class="btn btn-danger" /> |
            @Html.ActionLink("Volver al listado", "Index", null, new { @class = "module-back-link" })
        </div>
    }
</div>
</div>
<div class="module-footer-links">
    @Html.ActionLink("Volver al listado", "Index", null, new { @class = "module-back-link" })
</div>
