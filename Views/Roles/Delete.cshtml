@model RedFlix.Roles

@{
    ViewBag.Title = "Delete";
}

@{ ViewBag.ModuleTitle = "Eliminar"; ViewBag.ModuleSubtitle = "Tipos de usuario del sistema"; ViewBag.ShowCreate = false; }

@Html.Partial("_ModuleHeader")

<div class="module-card">
<p class="module-delete-warning">Estas seguro de que queres eliminar este registro?</p>
<div>
    <hr />
    <dl class="dl-horizontal module-details">
        <dt>
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Nombre)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Eliminar" class="btn btn-danger" /> |
            @Html.ActionLink("Volver al listado", "Index", null, new { @class = "module-back-link" })
        </div>
    }
</div>
</div>
<div class="module-footer-links">
    @Html.ActionLink("Volver al listado", "Index", null, new { @class = "module-back-link" })
</div>
