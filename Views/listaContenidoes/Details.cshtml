@model RedFlix.listaContenido

@{
    ViewBag.Title = "Details";
}

@{ ViewBag.ModuleTitle = "Detalle"; ViewBag.ModuleSubtitle = "Peliculas y series en listas"; ViewBag.ShowCreate = false; }

@Html.Partial("_ModuleHeader")

<div class="module-card">
<div>
    <hr />
    <dl class="dl-horizontal module-details">
        <dt>
            @Html.DisplayNameFor(model => model.listas.nombre)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.listas.nombre)
        </dd>

    </dl>
</div>
</div>
<div class="module-footer-links">
    @Html.ActionLink("Editar", "Edit", new { id = Model.ID }, new { @class = "btn btn-outline-light btn-sm" })
    @Html.ActionLink("Volver al listado", "Index", null, new { @class = "module-back-link" })
</div>
