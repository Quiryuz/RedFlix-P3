@model IEnumerable<RedFlix.listaContenido>

@{
    ViewBag.Title = "Index";
}

@{ ViewBag.ModuleTitle = "Contenido de listas"; ViewBag.ModuleSubtitle = "Peliculas y series en listas"; ViewBag.CreateText = "Agregar contenido"; }

@Html.Partial("_ModuleHeader")

<div class="module-card module-card-table">
    <div class="table-responsive">
<table class="table module-table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.listas.nombre)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.listas.nombre)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { /* id=item.PrimaryKey */ }) |
            @Html.ActionLink("Detalle", "Details", new { /* id=item.PrimaryKey */ }) |
            @Html.ActionLink("Eliminar", "Delete", new { /* id=item.PrimaryKey */ })
        </td>
    </tr>
}

</table>
    </div>
</div>

