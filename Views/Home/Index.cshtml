@using RedFlix.Models.Tmdb
@using RedFlix.Models.Clima
@{
    ViewBag.Title = "Inicio";
    var peliculas = ViewBag.PeliculasTendencia as List<TmdbMovieResult>;
    var series = ViewBag.SeriesTendencia as List<TmdbTvResult>;
    var clima = ViewBag.ClimaRecomendacion as ClimaRecomendacionViewModel;
    var peliculasClima = ViewBag.PeliculasPorClima as List<TmdbMovieResult>;
}

<section class="hero-banner">
    <div class="hero-content">
        <h1>RedFlix+</h1>
        <p>Peliculas, series, tendencias y recomendaciones en un solo lugar.</p>
        <div class="hero-actions">
            @Html.ActionLink("Ver peliculas", "Index", "Peliculas", null, new { @class = "btn btn-danger btn-lg" })
            @Html.ActionLink("Ver series", "Index", "Series", null, new { @class = "btn btn-outline-light btn-lg" })
        </div>
    </div>
</section>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (clima != null && peliculasClima != null && peliculasClima.Any())
{
    <section class="home-section weather-recommendation-section">
        <div class="weather-recommendation-card">
            <div>
                <p class="profile-menu-eyebrow">Recomendacion por clima</p>
                <h2>@clima.GeneroNombre para este clima</h2>
                <p class="weather-summary">
                    @clima.Ciudad - @clima.Descripcion - @clima.Temperatura.ToString("0") C
                </p>
                <p class="text-muted mb-0">@clima.Motivo</p>
                @Html.ActionLink("Ver recomendaciones", "RecomendadasPorClima", "Peliculas", null, new { @class = "btn btn-danger btn-sm mt-3" })
            </div>
            @if (!string.IsNullOrWhiteSpace(clima.Icono))
            {
                <img src="https://openweathermap.org/img/wn/@(clima.Icono)@("@2x.png")" alt="@clima.Descripcion" class="weather-icon" />
            }
        </div>

        <div class="catalog-grid catalog-grid-compact mt-3">
            @foreach (var item in peliculasClima.Take(8))
            {
                <a href="@Url.Action("Detalle", "Peliculas", new { id = item.Id })" class="catalog-card">
                    <img src="@RedFlix.Services.TMDBService.GetPosterUrl(item.PosterPath)" alt="@item.Title" class="catalog-poster" />
                    <div class="catalog-card-body">
                        <h3>@item.Title</h3>
                        <p class="catalog-meta">Puntaje @item.VoteAverage.ToString("0.0")</p>
                    </div>
                </a>
            }
        </div>
    </section>
}

@if (peliculas != null && peliculas.Any())
{
    <section class="home-section">
        <div class="section-header">
            <h2>Peliculas en tendencia</h2>
            @Html.ActionLink("Ver todas", "Tendencias", "Peliculas", null, new { @class = "section-link" })
        </div>
        <div class="catalog-grid catalog-grid-compact">
            @foreach (var item in peliculas.Take(8))
            {
                <a href="@Url.Action("Detalle", "Peliculas", new { id = item.Id })" class="catalog-card">
                    <img src="@RedFlix.Services.TMDBService.GetPosterUrl(item.PosterPath)" alt="@item.Title" class="catalog-poster" />
                    <div class="catalog-card-body">
                        <h3>@item.Title</h3>
                        <p class="catalog-meta">Puntaje @item.VoteAverage.ToString("0.0")</p>
                    </div>
                </a>
            }
        </div>
    </section>
}

@if (series != null && series.Any())
{
    <section class="home-section">
        <div class="section-header">
            <h2>Series en tendencia</h2>
            @Html.ActionLink("Ver todas", "Tendencias", "Series", null, new { @class = "section-link" })
        </div>
        <div class="catalog-grid catalog-grid-compact">
            @foreach (var item in series.Take(8))
            {
                <a href="@Url.Action("Detalle", "Series", new { id = item.Id })" class="catalog-card">
                    <img src="@RedFlix.Services.TMDBService.GetPosterUrl(item.PosterPath)" alt="@item.Name" class="catalog-poster" />
                    <div class="catalog-card-body">
                        <h3>@item.Name</h3>
                        <p class="catalog-meta">Puntaje @item.VoteAverage.ToString("0.0")</p>
                    </div>
                </a>
            }
        </div>
    </section>
}
