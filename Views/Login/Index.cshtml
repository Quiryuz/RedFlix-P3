@{
    ViewBag.Title = "Iniciar sesión";
}

<section class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <span class="auth-logo">RedFlix<span class="auth-logo-plus">+</span></span>
            <h1>Iniciar sesión</h1>
            <p>Accedé a tu cuenta para guardar favoritos, listas y calificaciones.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger auth-alert" role="alert">
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("Index", "Login", FormMethod.Post, new { @class = "auth-form" }))
        {
            @Html.AntiForgeryToken()

            <div class="auth-field">
                <label for="email">Email</label>
                <input type="email"
                       id="email"
                       name="email"
                       class="form-control auth-input"
                       placeholder="tu@email.com"
                       required
                       autocomplete="email" />
            </div>

            <div class="auth-field">
                <label for="contrasenia">Contraseña</label>
                <input type="password"
                       id="contrasenia"
                       name="contrasenia"
                       class="form-control auth-input"
                       placeholder="••••••••"
                       required
                       autocomplete="current-password" />
            </div>

            <button type="submit" class="btn btn-danger auth-submit w-100">
                Ingresar
            </button>
        }

        <div class="auth-footer">
            <p>¿No tenés cuenta?</p>
            <a href="@Url.Action("Registro", "Login")" class="btn btn-outline-light w-100">
                Crear cuenta
            </a>
            <a href="@Url.Action("Index", "Home")" class="auth-back-link">← Volver al inicio</a>
        </div>
    </div>
</section>
