@model RedFlix.usuarios

@{
    ViewBag.Title = "Crear Cuenta";
}

<style>
    body {
        background-color: #000;
        color: white;
    }

    .panel {
        max-width: 500px;
        margin: 40px auto;
        background-color: #141414;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 0 20px rgba(255,255,255,0.08);
    }

    .panel-heading {
        background-color: #141414 !important;
        border-bottom: 1px solid #333;
    }

    .panel-body {
        padding: 30px;
    }

    .panel-title {
        font-size: 24px;
        font-weight: 600;
        color: white !important;
    }

    .form-control {
        color: black;
    }

    .form-group {
        margin-bottom: 20px;
    }

    a {
        color: #E50914;
    }
</style>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="panel panel-default">

        <div class="panel-heading">
            <h3 class="panel-title text-center">
                Crear Cuenta
            </h3>
        </div>

        <div class="panel-body">

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(model => model.Nombre)

                @Html.EditorFor(
                    model => model.Nombre,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control"
                        }
                    })

                @Html.ValidationMessageFor(
                    model => model.Nombre,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Mail)

                @Html.EditorFor(
                    model => model.Mail,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control"
                        }
                    })

                @Html.ValidationMessageFor(
                    model => model.Mail,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Contrasena)

                @Html.PasswordFor(
                    model => model.Contrasena,
                    new
                    {
                        @class = "form-control"
                    })

                @Html.ValidationMessageFor(
                    model => model.Contrasena,
                    "",
                    new { @class = "text-danger" })
            </div>

            <div class="text-center">
                <input type="submit"
                       value="Crear Cuenta"
                       class="btn btn-danger" />
            </div>

        </div>

    </div>
}

<div class="text-center">
    @Html.ActionLink(
        "<< Volver al Login",
        "Index",
        "Login")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}