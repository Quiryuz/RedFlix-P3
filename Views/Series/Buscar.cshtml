@model IEnumerable<RedFlix.Models.Tmdb.TmdbTvResult>
@{
    ViewBag.Title = "Buscar series";
}

<div class="catalog-header">
    <h1 class="catalog-title">Resultados para "@ViewBag.Query"</h1>
</div>

<div class="catalog-toolbar">
    @using (Html.BeginForm("Buscar", "Series", FormMethod.Get, new { @class = "catalog-search-form" }))
    {
        <input type="text" name="q" value="@ViewBag.Query" class="form-control catalog-search-input" placeholder="Buscar series..." />
        <button type="submit" class="btn btn-danger">Buscar</button>
    }
    @Html.ActionLink("Ver populares", "Index", "Series", null, new { @class = "btn btn-outline-light btn-sm" })
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model == null || !Model.Any())
{
    <p class="text-muted">No se encontraron series.</p>
}
else
{
    <div class="catalog-grid">
        @foreach (var item in Model)
        {
            <a href="@Url.Action("Detalle", "Series", new { id = item.Id })" class="catalog-card">
                <img src="@RedFlix.Services.TMDBService.GetPosterUrl(item.PosterPath)" alt="@item.Name" class="catalog-poster" />
                <div class="catalog-card-body">
                    <h3>@item.Name</h3>
                    <p class="catalog-meta">★ @item.VoteAverage.ToString("0.0")</p>
                </div>
            </a>
        }
    </div>
}
