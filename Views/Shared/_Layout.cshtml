<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - RedFlix+</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">

        <div class="container">
            @Html.ActionLink("RedFlix", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Películas", "Index", "Peliculas", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Series", "Index", "Series", new { area = "" }, new { @class = "nav-link" })</li>

                    @if (Session["RolID"] != null &&
                    Convert.ToInt32(Session["RolID"]) == 1)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Administración
                            </a>

                            <ul class="dropdown-menu">
                                <li>
                                    @Html.ActionLink("Usuarios", "Index", "Usuarios", null,
                                        new { @class = "dropdown-item" })
                                </li>

                                <li>
                                    @Html.ActionLink("Roles", "Index", "Roles", null,
                                        new { @class = "dropdown-item" })
                                </li>

                                <li>
                                    @Html.ActionLink("Permisos", "Index", "Permisos", null,
                                        new { @class = "dropdown-item" })
                                </li>

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    @Html.ActionLink("Reportes", "Index", "Reportes", null,
                                        new { @class = "dropdown-item" })
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>



            <div class="navbar-auth d-flex align-items-center gap-3">
                @if (Session["Nombre"] != null)
                {
                    <span class="navbar-user">Hola, @Session["Nombre"]</span>
                    <a href="@Url.Action("Logout", "Login")" class="btn btn-outline-light btn-sm">
                        Cerrar sesión
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Index", "Login")" class="btn btn-danger btn-sm">
                        Iniciar sesión
                    </a>
                }
            </div>
        </div>
    </nav>

    <div class="body-content">
        @RenderBody()
    </div>

    <script src="~/Scripts/bootstrap.bundle.min.js"></script>

    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)
</body>
</html>
